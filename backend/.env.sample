GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
PORT=8080
GENMEDIA_BUCKET=your-bucket-name
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional: alternate TTS model used only on the final retry (e.g. to escape a
# PROHIBITED_CONTENT block). Leave unset to retry the primary TTS model instead
# of swapping to a different one.
#TTS_FALLBACK_MODEL=
# Optional: comma-separated list of exact origins (scheme+host+port) allowed to
# call the API cross-origin. Leave unset for same-origin only (the deployed app
# works with no value). For local dev set it to your app URL plus the Vite dev
# server, e.g. ALLOWED_ORIGINS=https://your-app.run.app,http://localhost:5173
#ALLOWED_ORIGINS=
# Optional: per-instance rate limit for /api endpoints. RATE_LIMIT_REQUESTS is
# the request count (default 10); RATE_LIMIT_WINDOW is a Go duration string
# (default 1m). Invalid values fall back to the defaults.
#RATE_LIMIT_REQUESTS=10
#RATE_LIMIT_WINDOW=1m
